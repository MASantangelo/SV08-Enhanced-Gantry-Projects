{
  "_help": "Rules that turn CAD names from the STEP file into BOM lines. Names are matched after Fusion copy/mirror suffixes like ' (2)(Mirror)', '_1', '.f3d' and ' x2' are stripped. Patterns are Python regular expressions. 'common' applies to every variant; 'variants' adds to it per variant folder. See tools/README.md.",
  "common": {
    "exclude_assemblies": [
      "^SV08 .* Z Carriage$"
    ],
    "unit_assemblies": {
      "^D2F-L_Straight$": {
        "as": "D2F-L Micro Switch (Endstop)"
      },
      "^GT2 20 Tooth Live Idler Pulley$": {
        "as": "GT2 20-Tooth Pulley - Live Idler Version",
        "descend": true
      }
    },
    "category_by_assembly": {
      "^Xol Hardware$": "Xol Toolhead Hardware",
      "^Linear Rails$": {
        "as": "Linear Rail Mounting Hardware",
        "only": "^(T-Nut - M3|M3x8mm SHCS)$"
      }
    },
    "rename": {
      "T-Nut M4": "M4 T-Nut",
      "T-Nut - M3": "M3 T-Nut",
      "F695-2RS Bearing Single": "695-2RS Flanged Bearing",
      "M3 Shim 5mm OD .2mm Tall": "M3 Shim (3mm ID | 5mm OD | .2mm Tall)",
      "M3x20mmx8mm Spacer": "M3 Spacer 8mm OD 20mm Tall",
      "MG9H Linear Rail Slide": "MGN9H Linear Rail Slide",
      "Y Axis Linear Rail": "Y MGN9H Rail 402mm",
      "Y Axis Linear Rail MG9H 402mm": "Y MGN9H Rail 402mm",
      "X Axis Linear Rail (MG12H 406mm)": "X MGN12H Rail 406mm"
    },
    "rename_patterns": [
      [
        "^(D5 M\\d)x(\\d+)mm ",
        "\\1 x \\2mm "
      ],
      [
        "^(M\\d)x(\\d+)mm ",
        "\\1 x \\2mm "
      ]
    ],
    "ignore_parts": [],
    "bom_only": []
  },
  "variants": {
    "Printed Version": {
      "unit_assemblies": {
        "^Front Left (Top|Bottom) Printed6mm$": {}
      }
    },
    "CF Version": {
      "unit_assemblies": {
        "^Front Left (Top|Bottom) CF6mm$": {}
      }
    },
    "CF Version/9mm Belt Mod": {
      "unit_assemblies": {
        "^GT2 20 Tooth Live Idler Pulley 9mm Belt Version$": {
          "as": "GT2 20-Tooth Pulley - Live Idler Version (9mm Belt)",
          "descend": true
        }
      },
      "rename": {
        "GT2 Pulley for 9mm Belts": "GT2 20-Tooth Pulley Set-Screw Version (9mm Belt)",
        "Bottom Belt": "Bottom Belt 2.1m (9mm)",
        "Top Belt": "Top Belt 2.1m (9mm)",
        "M4x55 BHCS": "M4 x 55mm BHCS",
        "M5x60 SHCS": "M5 x 60mm SHCS"
      }
    }
  }
}
